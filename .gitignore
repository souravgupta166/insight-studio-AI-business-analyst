# =========================================================
# DATABASE FILES
# =========================================================

# Ignore DuckDB files by default
*.duckdb
*.duckdb.wal

# Allow the production Olist database to be committed
!/data/processed/olist.duckdb

# Ignore other processed data artifacts
/data/processed/**
!/data/processed/olist.duckdb

# =========================================================
# RAW DATASETS
# =========================================================

data/raw/

